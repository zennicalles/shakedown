[5.086,"o","\u001b[1m1/2  A refund agent with naive tools, under every fault Shakedown injects\u001b[0m\r\n"]
[5.155,"o","\u001b[2m     It looks up ch_1, refunds £50, emails the customer, and retries a failed call up to 3 times.\u001b[0m\r\n"]
[5.405,"o","\r\n"]
